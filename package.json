  },
  "homepage": "https://github.com/gluztm/dsh-chief#readme",
  "bugs": {
    "url": "https://github.com/gluztm/dsh-chief/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "superagent",
    "chief-of-staff",
    "multi-agent",
    "agent-orchestration",
    "subagent",
    "dag",
    "workflow",
    "archive-vault",
