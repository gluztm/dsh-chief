{
  "name": "dsh-chief",
  "version": "1.3.0",
  "icon": "icon.svg",
  "type": "module",
  "description": "AI manager for your agent crews. Let AI manage AI — it watches the flow, stops a runaway loop before it burns budget, and asks before touching your workspace. Less babysitting, fewer blow-ups.",
  "author": "gluztm",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluztm/dsh-chief.git"
  },
  "homepage": "https://github.com/gluztm/dsh-chief#readme",
  "bugs": {
    "url": "https://github.com/gluztm/dsh-chief/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-manager",
    "ai管家",
    "ai-orchestrator",
    "ai-supervisor",
    "no-babysitting",
    "免监工",
    "autonomous-agents",
    "agent-orchestration",
    "multi-agent",
    "subagent",
    "dag",
    "session-management",
    "long-session",
    "workflow-automation",
    "context-compaction",
    "cross-session-memory",
    "cost-control",
    "runaway-loop",
    "read-only-guardrails",
    "handoff",
    "archive-vault",
    "superagent"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "main": "./index.js",
  "scripts": {
    "build:client": "node ./scripts/build-client.mjs",
    "check:client": "node ./scripts/build-client.mjs --check",
    "check:syntax": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('.').filter(x=>x.endsWith('.js')))cp.execFileSync(process.execPath,['--check',f]);\"",
    "test:ci": "npm run check:client && npm run check:syntax && node ./tests/verify-v130-release-gate.mjs",
    "test": "node ./tests/verify-v130-release-gate.mjs && node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');if(fs.existsSync('../tools')){for(const s of ['verify-chief-facade-split.mjs','verify-index-modular-split.mjs','verify-archives-modular-split.mjs','verify-client-modular-build.mjs','verify-v121-permissions-and-ui.mjs','verify-compaction-and-blank-chat.mjs','check-action-surface.mjs','verify-v130-four-chains.mjs']){cp.execFileSync(process.execPath,[path.resolve('..','tools',s)],{stdio:'inherit'});}}\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "board-schema.js",
    "board-store.js",
    "board-actions.js",
    "subagent-runtime.js",
    "api-routes.js",
    "model-tools.js",
    "runtime-hooks.js",
    "client.js",
    "chief.js",
    "chief-state.js",
    "chief-models.js",
    "chief-network.js",
    "chief-view.js",
    "chief-archives.js",
    "chief-compaction.js",
    "chief-commands.js",
    "chief-review.js",
    "chief-approvals.js",
    "chief-executor.js",
    "auto-continue.js",
    "archives.js",
    "archive-core.js",
    "archive-cabinets.js",
    "archive-precipitated.js",
    "archive-dossiers.js",
    "idle-guard.js",
    "memory.js",
    "digest.js",
    "handoff.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
