{
  "name": "dsh-chief",
  "version": "1.7.1",
  "icon": "icon.svg",
  "type": "module",
  "description": "A quiet sidekick beside DeepSeek Harness: stays out of the way in plain chats, chimes in with tips and safety checks while you're here, and takes over when you step away.",
  "author": "gluztm",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluztm/dsh-chief.git"
  },
  "homepage": "https://github.com/gluztm/dsh-chief#readme",
  "bugs": {
    "url": "https://github.com/gluztm/dsh-chief/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-compaction",
    "compaction-amnesia",
    "context-loss",
    "context-window",
    "token-saving",
    "agent-loop",
    "infinite-loop",
    "unattended-agent",
    "overnight-coding",
    "auto-continue",
    "stop-babysitting",
    "session-handoff",
    "chat-too-long",
    "cross-session-memory",
    "subagent-monitor",
    "multi-agent",
    "task-dag",
    "approval-gate",
    "human-in-the-loop",
    "read-only-mode",
    "command-guardrails",
    "workspace-safety",
    "guard-walls",
    "pre-execute-guard",
    "事前拦截",
    "压缩失忆",
    "挂机跑任务",
    "跨窗口交接",
    "防死循环",
    "只读护栏",
    "ai-manager",
    "superagent",
    "cognitive-desktop",
    "thinking-effort",
    "dream-roam",
    "认知桌面",
    "物理驻墙",
    "workflow-topology",
    "bilingual"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "main": "./index.js",
  "scripts": {
    "build:client": "node ./scripts/build-client.mjs",
    "check:client": "node ./scripts/build-client.mjs --check",
    "check:syntax": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const walk=d=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory()&&(e.name==='safety'||e.name==='src'||e.name==='client'))walk(p);else if(e.isFile()&&e.name.endsWith('.js'))cp.execFileSync(process.execPath,['--check',p]);}};walk('.');\"",
    "test:ci": "npm run check:client && npm run check:syntax && node ./tests/verify-v130-release-gate.mjs && node ./tests/verify-v140-safety-gate.mjs && node ./tests/verify-v140-collab-gate.mjs && node ./tests/verify-v150-final-gate.mjs && node ./tests/verify-v160-flow-gate.mjs && node ./tests/verify-v170-dsh023-compat.mjs",
    "test": "node ./tests/verify-v130-release-gate.mjs && node ./tests/verify-v140-safety-gate.mjs && node ./tests/verify-v140-collab-gate.mjs && node ./tests/verify-v150-final-gate.mjs && node ./tests/verify-v160-flow-gate.mjs && node ./tests/verify-v170-dsh023-compat.mjs && node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');if(fs.existsSync('../tools')){for(const s of ['verify-chief-facade-split.mjs','verify-index-modular-split.mjs','verify-archives-modular-split.mjs','verify-client-modular-build.mjs','verify-v121-permissions-and-ui.mjs','verify-compaction-and-blank-chat.mjs','check-action-surface.mjs','verify-v130-four-chains.mjs']){cp.execFileSync(process.execPath,[path.resolve('..','tools',s)],{stdio:'inherit'});}}\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "board-schema.js",
    "board-store.js",
    "board-actions.js",
    "subagent-runtime.js",
    "api-routes.js",
    "model-tools.js",
    "runtime-hooks.js",
    "client.js",
    "chief.js",
    "chief-state.js",
    "chief-models.js",
    "chief-network.js",
    "chief-view.js",
    "chief-archives.js",
    "chief-compaction.js",
    "chief-commands.js",
    "chief-review.js",
    "chief-approvals.js",
    "chief-executor.js",
    "board-handoff.js",
    "network-harness.js",
    "state-schema.js",
    "state-media.js",
    "command-helpers.js",
    "command-ops.js",
    "safety/*.js",
    "auto-continue.js",
    "archives.js",
    "archive-core.js",
    "archive-cabinets.js",
    "archive-precipitated.js",
    "archive-dossiers.js",
    "idle-guard.js",
    "memory.js",
    "digest.js",
    "handoff.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
