{
  "name": "dsh-chief",
  "version": "1.2.1",
  "icon": "icon.svg",
  "type": "module",
  "description": "AI manager for your agent crews. Let AI manage AI — it watches the flow, stops a runaway loop before it burns budget, and asks before touching your workspace. Less babysitting, fewer blow-ups.",
  "author": "gluztm",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluztm/dsh-chief.git"
  },
  "homepage": "https://github.com/gluztm/dsh-chief#readme",
  "bugs": {
    "url": "https://github.com/gluztm/dsh-chief/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-manager",
    "ai管家",
    "ai-orchestrator",
    "ai-supervisor",
    "no-babysitting",
    "免监工",
    "autonomous-agents",
    "agent-orchestration",
    "multi-agent",
    "subagent",
    "dag",
    "session-management",
    "long-session",
    "workflow-automation",
    "context-compaction",
    "cross-session-memory",
    "cost-control",
    "runaway-loop",
    "read-only-guardrails",
    "handoff",
    "archive-vault",
    "superagent"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "chief.js",
    "chief-executor.js",
    "auto-continue.js",
    "archives.js",
    "idle-guard.js",
    "memory.js",
    "digest.js",
    "handoff.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
